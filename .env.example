# =================================================================
# Sentiment AI — Root Environment Configuration
# Copy this file to .env and fill in the values.
# Used by Docker Compose for production deployment.
# =================================================================

# ── Backend ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── JWT ───────────────────────────────────────────────────────────
# REQUIRED: Replace with a long random secret (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── PostgreSQL (Docker) ───────────────────────────────────────────
POSTGRES_USER=sentiment_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=sentiment_ai
POSTGRES_PORT=5432

# ── CORS ──────────────────────────────────────────────────────────
# The public URL of your frontend (used to restrict CORS)
FRONTEND_URL=http://localhost:3000

# ── Frontend build args (baked in at build time) ──────────────────
VITE_API_URL=http://localhost:5000/api

# ── Local development overrides (backend/.env) ────────────────────
# For local dev, use:
#   DATABASE_URL=file:./prisma/dev.db
#   ML_SERVICE_URL=http://127.0.0.1:8000
#   FRONTEND_URL=http://localhost:5173
